# Hangi LLM sağlayıcısı kullanılacak: gemini | groq | ollama | openai | anthropic
LLM_PROVIDER=gemini

# Boş bırakılırsa sağlayıcının varsayılan modeli kullanılır
# (gemini-flash-latest, llama-3.3-70b-versatile, qwen3:8b, gpt-5-mini, claude-opus-5-5)
LLM_MODEL=

# Gemini model yoğun olduğunda (503) ilk adımda geçilecek model.
# LLM_MODEL boşsa varsayılan: gemini-flash-lite-latest
LLM_FALLBACK_MODEL=

# Yalnızca seçtiğiniz sağlayıcının anahtarı gerekir
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama yerelde çalışıyorsa (anahtar gerekmez)
OLLAMA_BASE_URL=http://localhost:11434
